---
import { type Locale, useTranslation } from '../i18n/i18n'

const currentLocale = Astro.currentLocale as Locale
const t = useTranslation(currentLocale)
const link = 'link-underline inline-flex items-center min-h-11 px-2'
---

<footer id='contact' class='mt-28 border-t border-line'>
  <div class='wrap flex flex-wrap justify-between items-end gap-10 pt-[72px] pb-10'>
    <div class='flex flex-col gap-4 min-w-0'>
      <span class='font-mono text-[13px] text-muted'>03</span>
      <h2 class='text-[40px] font-semibold tracking-tight leading-[1.1]'>
        {t('contact.title')}
      </h2>
      <a
        href='mailto:alvaromagu2002@gmail.com'
        class='link-underline text-[clamp(20px,3vw,30px)] leading-snug break-all'
      >
        alvaromagu2002@gmail.com
      </a>
    </div>
    <nav aria-label={t('footer.links')} class='flex flex-wrap gap-x-2 text-[15px]'>
      <a href='https://github.com/alvaromagu' target='_blank' class={link}>GitHub</a>
      <a href='https://www.linkedin.com/in/alvaromagu/' target='_blank' class={link}>LinkedIn</a>
      <a href='/documents/cv-es.pdf' target='_blank' class={link}>{t('footer.cv.es')}</a>
      <a href='/documents/cv-en.pdf' target='_blank' class={link}>{t('footer.cv.en')}</a>
    </nav>
  </div>
  <div class='wrap flex flex-wrap justify-between gap-x-6 gap-y-2 pt-5 pb-8 font-mono text-xs text-muted'>
    <span>© {new Date().getFullYear()} Álvaro Martínez</span>
    <span>{t('footer.made.with')}</span>
  </div>
</footer>
