---
import { type Locale, useTranslation } from '../i18n/i18n'
import SectionHeader from './SectionHeader.astro'

const currentLocale = Astro.currentLocale as Locale
const t = useTranslation(currentLocale)

const experience = [
  {
    time: t('experience.tartis.time'),
    title: t('experience.tartis.title'),
    content: t('experience.tartis.description')
  },
  {
    time: t('experience.i2e.time'),
    title: t('experience.i2e.title'),
    content: t('experience.i2e.description')
  },
  {
    time: t('experience.sime.time'),
    title: t('experience.sime.title'),
    content: t('experience.sime.description')
  },
  {
    time: t('experience.dam.time'),
    title: t('experience.dam.title'),
    content: t('experience.dam.description')
  }
]
---

<section id='experience' class='wrap pt-28 pb-6'>
  <SectionHeader index='02' title={t('experience.title')} />
  <ol>
    {
      experience.map((item) => (
        <li class='flex flex-wrap gap-x-12 gap-y-2.5 py-8 border-b border-line'>
          <p class='basis-60 shrink-0 grow-0 pt-1 font-mono text-[13px] leading-relaxed text-muted'>
            {item.time}
          </p>
          <div class='flex flex-col gap-2.5 flex-[1_1_420px] min-w-0'>
            <h3 class='text-[22px] font-semibold leading-snug'>{item.title}</h3>
            <p class='max-w-[64ch] leading-[1.65] text-muted'>{item.content}</p>
          </div>
        </li>
      ))
    }
  </ol>
</section>
