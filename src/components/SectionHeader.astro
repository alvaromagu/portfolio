---
interface Props {
  index: string
  title: string
}

const { index, title } = Astro.props
---

<div
  class='flex flex-wrap justify-between items-end gap-4 pb-5 border-b border-line'
>
  <div class='flex items-baseline gap-4'>
    <span class='font-mono text-[13px] text-muted'>{index}</span>
    <h2 class='text-[40px] font-semibold tracking-tight leading-[1.1]'>
      {title}
    </h2>
  </div>
  <slot />
</div>
