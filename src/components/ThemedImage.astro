---
import type { HTMLAttributes } from 'astro/types'

type Props = Omit<HTMLAttributes<'img'>, 'src' | 'alt'> & {
  alt: string
  light: string
  dark: string
}

const { light, dark, alt, class: className = '', ...props } = Astro.props
---

<img {...props} src={light} alt={alt} class={`dark:hidden ${className}`} />
<img {...props} src={dark} alt={alt} class={`hidden dark:block ${className}`} />
